# Copy this file to .env.production and replace every production placeholder.
# docker-compose.production.yml requires Telegram, OpenAI and public URL values.
COMPOSE_PROJECT_NAME=platforma

POSTGRES_DB=platforma
POSTGRES_USER=platforma
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://platforma:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/platforma?schema=public

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_BUCKET=platforma
TRAINING_DOCUMENT_BUCKET=platforma-training-private
# Required in production, must be a dedicated private bucket and must differ
# from MINIO_BUCKET. API/worker startup verifies policy/ACL and anonymous access.
TRAINING_AUDIO_BUCKET=platforma-training-audio-private
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.your-domain.ru
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY

API_PORT=3000
WEB_PORT=5173
FEED_AUTO_IMPORT_ENABLED=true
TRAINING_MODULE_ENABLED=true

# NODE_ENV and TELEGRAM_TRANSPORT_MODE are fixed by docker-compose.production.yml.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_REAL_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_URL=https://api.your-domain.ru/training/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_STRONG_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
TELEGRAM_WORKER_POLL_MS=250
TELEGRAM_WORKER_LEASE_MS=30000
TELEGRAM_WORKER_HEARTBEAT_MS=5000
TELEGRAM_WORKER_DRAIN_TIMEOUT_MS=10000
TRAINING_AUDIO_MAX_BYTES=20971520
TRAINING_AUDIO_MAX_ANSWER_BYTES=83886080
TRAINING_AUDIO_MAX_SEGMENTS=32
TRAINING_AUDIO_MAX_DURATION_SECONDS=600
TRAINING_AUDIO_DOWNLOAD_TIMEOUT_MS=30000
TRAINING_FFMPEG_TIMEOUT_MS=90000
TRAINING_AUDIO_WORKER_POLL_MS=500
TRAINING_AUDIO_WORKER_CONCURRENCY=2
TRAINING_AUDIO_WORKER_LEASE_MS=120000
TRAINING_AUDIO_WORKER_HEARTBEAT_MS=5000
TRAINING_AUDIO_WORKER_DRAIN_TIMEOUT_MS=30000
TRAINING_AUDIO_TEMP_DIR=/tmp/platforma-training-audio
# 0 means indefinite retention; other values are rejected at stage 7.
TRAINING_AUDIO_RETENTION_DAYS=0

# OPENAI_PROVIDER_MODE is fixed to real by docker-compose.production.yml.
# Replace every value below explicitly. Placeholder and repeated-mask API keys
# are rejected without exposing the key in the error.
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_API_KEY
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
OPENAI_TRANSCRIPTION_REVIEW_MODEL=gpt-4o-transcribe
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
OPENAI_EVALUATION_REASONING=medium
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_REVIEW_REASONING=high
OPENAI_TRANSCRIPTION_TIMEOUT_MS=60000
OPENAI_EVALUATION_TIMEOUT_MS=120000
OPENAI_TRANSCRIPTION_MAX_RETRIES=2
OPENAI_EVALUATION_MAX_RETRIES=2
OPENAI_TRANSCRIPTION_MAX_BYTES=25165824
OPENAI_MAX_RESPONSE_BYTES=2097152
OPENAI_EVALUATION_MAX_OUTPUT_TOKENS=4096
OPENAI_SMOKE_ENABLED=false

VITE_API_URL=https://api.your-domain.ru
WEB_ORIGIN=https://app.your-domain.ru
PUBLIC_APP_URL=https://app.your-domain.ru

JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET
JWT_MEDIA_SECRET=REPLACE_WITH_LONG_RANDOM_MEDIA_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MEDIA_TOKEN_TTL_MINUTES=200
EMAIL_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_EMAIL_SECRET
EMAIL_AUTH_TTL_MINUTES=15
REFRESH_COOKIE_NAME=platforma_refresh_token
MEDIA_COOKIE_NAME=platforma_media_token

SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
