# Copy this file to .env.production and replace every production placeholder.
# docker-compose.production.yml requires the Telegram and public URL values.
COMPOSE_PROJECT_NAME=platforma

POSTGRES_DB=platforma
POSTGRES_USER=platforma
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://platforma:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/platforma?schema=public

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_BUCKET=platforma
TRAINING_DOCUMENT_BUCKET=platforma-training-private
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.your-domain.ru
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY

API_PORT=3000
WEB_PORT=5173
FEED_AUTO_IMPORT_ENABLED=true
TRAINING_MODULE_ENABLED=true

# NODE_ENV and TELEGRAM_TRANSPORT_MODE are fixed by docker-compose.production.yml.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_REAL_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_URL=https://api.your-domain.ru/training/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_STRONG_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
TELEGRAM_WORKER_POLL_MS=250
TELEGRAM_WORKER_LEASE_MS=30000
TELEGRAM_WORKER_HEARTBEAT_MS=5000
TELEGRAM_WORKER_DRAIN_TIMEOUT_MS=10000

VITE_API_URL=https://api.your-domain.ru
WEB_ORIGIN=https://app.your-domain.ru
PUBLIC_APP_URL=https://app.your-domain.ru

JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET
JWT_MEDIA_SECRET=REPLACE_WITH_LONG_RANDOM_MEDIA_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MEDIA_TOKEN_TTL_MINUTES=200
EMAIL_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_EMAIL_SECRET
EMAIL_AUTH_TTL_MINUTES=15
REFRESH_COOKIE_NAME=platforma_refresh_token
MEDIA_COOKIE_NAME=platforma_media_token

SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
