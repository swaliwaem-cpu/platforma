# Copy this file to .env.production and replace every production placeholder.
# docker-compose.production.yml requires Telegram, OpenAI and public URL values.
COMPOSE_PROJECT_NAME=platforma
API_IMAGE=registry.example.com/platforma-api@sha256:REPLACE_WITH_API_IMAGE_DIGEST
WEB_IMAGE=registry.example.com/platforma-web@sha256:REPLACE_WITH_WEB_IMAGE_DIGEST
NODE_ENV=production
DEPLOYMENT_ENV=production
STAGING_ALLOW_FAKE_PROVIDERS=false

POSTGRES_DB=platforma
POSTGRES_USER=platforma
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://platforma:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/platforma?schema=public

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=REPLACE_WITH_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_BUCKET=platforma
# Both training buckets are required in production and must be private and
# distinct from each other and from MINIO_BUCKET.
TRAINING_AUDIO_BUCKET=platforma-training-audio-private
TRAINING_MATERIAL_BUCKET=platforma-training-materials-private
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.your-domain.ru
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY

API_PORT=3000
WEB_PORT=5173
FEED_AUTO_IMPORT_ENABLED=true
TRAINING_MODULE_ENABLED=true
TRAINING_VOICE_WORKER_ENABLED=false
TRAINING_MATERIAL_WORKER_ENABLED=true
TRAINING_AI_MODE=openai

# NODE_ENV, worker ownership, provider modes and the 100 MiB material limit are
# fixed by the production Compose overlay.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_REAL_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_URL=https://api.your-domain.ru/training/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_STRONG_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_REQUEST_TIMEOUT_MS=5000

TRAINING_AUDIO_MAX_DURATION_SECONDS=1800
TRAINING_AUDIO_MAX_SEGMENT_BYTES=20971520
TRAINING_AUDIO_MAX_TOTAL_INPUT_BYTES=62914560
TRAINING_AUDIO_PROVIDER_UPLOAD_MAX_BYTES=25165824
TRAINING_AUDIO_MAX_BUFFERED_BYTES=67108864
TRAINING_AUDIO_OPUS_BITRATE_BPS=32000
TRAINING_AUDIO_CHUNK_OVERLAP_SECONDS=2
TRAINING_FFMPEG_TIMEOUT_MS=120000
TRAINING_FFMPEG_CONCURRENCY=1
TRAINING_VOICE_WORKER_CONCURRENCY=3
TRAINING_VOICE_WORKER_SHUTDOWN_DRAIN_MS=10000
TRAINING_VOICE_WORKER_POLL_INTERVAL_MS=2000
TRAINING_VOICE_STALE_LOCK_MS=120000
TRAINING_VOICE_HEARTBEAT_INTERVAL_MS=30000
TRAINING_CROSS_PROJECT_GENERATION_REUSE_ENABLED=false
TRAINING_HARMLESS_EXTRA_ROUTING_ENABLED=false

TRAINING_MATERIAL_MAX_BYTES=104857600
TRAINING_MATERIAL_EXTRACTION_TIMEOUT_MS=60000
TRAINING_MATERIAL_MAX_TEXT_CHARS=2000000
TRAINING_MATERIAL_BROWSER_FALLBACK_ENABLED=false
TRAINING_MATERIAL_BROWSER_TIMEOUT_MS=30000
TRAINING_MATERIAL_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser
TRAINING_MATERIAL_SUGGESTION_TIMEOUT_MS=120000

# Replace the API key explicitly. Production startup rejects placeholders
# without exposing the key in the error.
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_API_KEY
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
OPENAI_QUESTION_GENERATION_MODEL=gpt-5.6-terra
OPENAI_QUESTION_GENERATION_LUNA_MODEL=gpt-5.6-luna
OPENAI_QUESTION_GENERATION_STRATEGY=terra_only
OPENAI_EVALUATOR_MODEL=gpt-5.6-terra
OPENAI_EVALUATOR_REASONING=medium
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
OPENAI_EVALUATION_REASONING=medium
OPENAI_TRANSCRIPTION_TIMEOUT_MS=60000
OPENAI_EVALUATION_TIMEOUT_MS=120000
OPENAI_TRANSCRIPTION_MAX_RETRIES=2
OPENAI_EVALUATION_MAX_RETRIES=2
OPENAI_EVALUATION_MAX_OUTPUT_TOKENS=4000
OPENAI_SMOKE_ENABLED=false

VITE_API_URL=https://api.your-domain.ru
WEB_ORIGIN=https://app.your-domain.ru
PUBLIC_APP_URL=https://app.your-domain.ru

JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET
JWT_MEDIA_SECRET=REPLACE_WITH_LONG_RANDOM_MEDIA_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MEDIA_TOKEN_TTL_MINUTES=200
EMAIL_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_EMAIL_SECRET
EMAIL_AUTH_TTL_MINUTES=15
REFRESH_COOKIE_NAME=platforma_refresh_token
MEDIA_COOKIE_NAME=platforma_media_token

SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=REPLACE_WITH_MAIL_FROM_ADDRESS

WP_DB_HOST=REPLACE_WITH_WORDPRESS_DATABASE_HOST
WP_DB_PORT=3306
WP_DB_USER=REPLACE_WITH_WORDPRESS_READONLY_USER
WP_DB_PASSWORD=REPLACE_WITH_WORDPRESS_READONLY_PASSWORD
WP_DB_NAME=REPLACE_WITH_WORDPRESS_DATABASE_NAME
WP_TABLE_PREFIX=wp_
WP_UPLOADS_HOST_PATH=REPLACE_WITH_WORDPRESS_UPLOADS_HOST_PATH
WP_UPLOADS_PATH=/wp-uploads
