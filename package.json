{
  "name": "platforma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @platforma/api build",
    "build:web": "pnpm --filter @platforma/web build",
    "db:generate": "pnpm --filter @platforma/api prisma:generate",
    "db:migrate": "pnpm --filter @platforma/api prisma:migrate",
    "db:seed": "pnpm --filter @platforma/api db:seed",
    "dev:api": "pnpm --filter @platforma/api dev",
    "dev:web": "pnpm --filter @platforma/web dev",
    "test": "pnpm -r --if-present test",
    "test:training-v2:e2e": "node apps/api/tests/training-v2-stage5-part4-e2e.cjs",
    "test:training:openai:smoke": "pnpm --filter @platforma/api test:training:openai:smoke",
    "benchmark:training:question-budget": "pnpm build:api && node --env-file-if-exists=.env apps/api/tests/training-v2-question-budget-benchmark.cjs",
    "benchmark:training:luna-terra": "pnpm build:api && node --env-file-if-exists=.env apps/api/tests/training-v2-luna-terra-benchmark.cjs",
    "benchmark:training:evaluator": "pnpm build:api && node --env-file-if-exists=.env apps/api/tests/training-v2-evaluator-efficiency-benchmark.cjs",
    "benchmark:assistant:embeddings": "pnpm build:api && node --env-file-if-exists=.env apps/api/scripts/assistant-embedding-benchmark.cjs",
    "test:assistant:fix-token:postgres": "pnpm build:api && node apps/api/tests/assistant-fix-token-postgres.cjs",
    "test:assistant:t03:postgres": "pnpm build:api && node apps/api/tests/assistant-t03-postgres.cjs",
    "test:assistant:t03:browser": "pnpm build:api && node apps/api/tests/assistant-t03-browser-runtime.cjs",
    "test:assistant:t05:postgres": "pnpm build:api && node apps/api/tests/assistant-t05-postgres.cjs",
    "test:assistant:fix-geo1:targeted": "pnpm build:api && node --test apps/api/tests/assistant-fix-geo1-domain.test.cjs apps/api/tests/assistant-fix-geo1-live-smoke.test.cjs apps/api/tests/assistant-local-paid-smoke.test.cjs apps/api/tests/assistant-pidafix3-geo-live.test.cjs apps/api/tests/assistant-t05-domain.test.cjs && pnpm build:web && pnpm --filter @platforma/web exec node --test tests/assistant-t05-ui.test.mjs tests/map-module.test.mjs",
    "test:assistant:fix-geo1:postgres": "pnpm build:api && node apps/api/tests/assistant-t05-postgres.cjs && node --test apps/api/tests/assistant-pidafix2-postgres.cjs",
    "test:assistant:fix-geo1:browser": "pnpm --filter @platforma/web test:assistant:t05:browser",
    "smoke:assistant:fix-geo1:local-stub": "docker compose exec -T -e ASSISTANT_FIX_GEO1_LOCAL_STUB_ACCESS_TOKEN api node apps/api/scripts/assistant-fix-geo1-live-smoke.cjs",
    "smoke:assistant:pidafix3:geo": "node apps/api/scripts/assistant-pidafix3-geo-live.cjs",
    "smoke:assistant:local-paid": "docker compose exec -T -e ASSISTANT_LOCAL_PAID_SMOKE_ACCESS_TOKEN api node apps/api/scripts/assistant-local-paid-smoke.cjs",
    "test:assistant:t06:postgres": "pnpm build:api && node apps/api/tests/assistant-t06-postgres.cjs",
    "test:assistant:t06:browser": "pnpm --filter @platforma/web test:assistant:t06:browser",
    "test:assistant:t07:domain": "pnpm build:api && node apps/api/tests/assistant-t07-domain.test.cjs",
    "test:assistant:t07:targeted": "pnpm build:api && node apps/api/tests/assistant-t03-domain.test.cjs && node apps/api/tests/assistant-t05-domain.test.cjs && node apps/api/tests/assistant-t06-domain.test.cjs && node apps/api/tests/assistant-t07-domain.test.cjs && pnpm --filter @platforma/web exec node --test tests/assistant-t03-ui.test.mjs tests/assistant-t05-ui.test.mjs tests/assistant-t06-ui.test.mjs tests/map-amenity-overlays.test.mjs tests/map-label-localization.test.mjs tests/map-module.test.mjs tests/map-runtime-config-server.test.mjs",
    "test:assistant:t07:e2e": "pnpm build:api && node apps/api/tests/assistant-t07-e2e.cjs",
    "test:assistant:zaebal6:unit": "pnpm build:api && node --test apps/api/tests/assistant-eval-runner.test.cjs",
    "test:assistant:pidafix3:baseline:unit": "pnpm build:api && node --test apps/api/tests/assistant-pidafix3-baseline.test.cjs apps/api/tests/assistant-pidafix3-geo-live.test.cjs apps/api/tests/project-presentations-worker-config.test.cjs",
    "test:assistant:pidafix3:baseline": "node apps/api/scripts/assistant-pidafix3-baseline.cjs --execute",
    "eval:assistant:manifest": "pnpm build:api && node apps/api/scripts/assistant-eval-manifest.cjs",
    "eval:assistant:run": "pnpm build:api && node apps/api/scripts/assistant-eval-runner.cjs",
    "eval:assistant": "pnpm build:api && node apps/api/scripts/assistant-eval.cjs",
    "eval:assistant:cleanup": "pnpm build:api && node apps/api/scripts/assistant-eval-cleanup.cjs",
    "assistant:rollout:preflight": "pnpm build:api && node apps/api/scripts/assistant-rollout-preflight.cjs",
    "assistant:rollout:advance": "pnpm build:api && node apps/api/scripts/assistant-rollout-preflight.cjs --record-stage",
    "assistant:sources:discover": "pnpm build:api && node --env-file-if-exists=.env apps/api/scripts/assistant-source-discovery.cjs",
    "training:webhook:status": "node --env-file-if-exists=.env apps/api/scripts/training-telegram-webhook.cjs status",
    "training:webhook:register": "node --env-file-if-exists=.env apps/api/scripts/training-telegram-webhook.cjs register",
    "training:webhook:delete": "node --env-file-if-exists=.env apps/api/scripts/training-telegram-webhook.cjs delete",
    "training:worker:predeploy": "node --env-file-if-exists=.env apps/api/scripts/training-voice-worker-predeploy.cjs",
    "feed-import:preview": "pnpm --filter @platforma/feed-import run preview",
    "feed-import:run": "pnpm --filter @platforma/feed-import run run",
    "wp-import:preview": "pnpm --filter @platforma/wp-import run preview",
    "wp-import:repair:preview": "pnpm --filter @platforma/wp-import run repair:preview",
    "wp-import:repair:run": "pnpm --filter @platforma/wp-import run repair:run",
    "wp-import:run": "pnpm --filter @platforma/wp-import run run"
  }
}
