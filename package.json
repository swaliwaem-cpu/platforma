{
  "name": "platforma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @platforma/api build",
    "build:web": "pnpm --filter @platforma/web build",
    "db:generate": "pnpm --filter @platforma/api prisma:generate",
    "db:migrate": "pnpm --filter @platforma/api prisma:migrate",
    "db:seed": "pnpm --filter @platforma/api db:seed",
    "dev:api": "pnpm --filter @platforma/api dev",
    "dev:web": "pnpm --filter @platforma/web dev",
    "test": "pnpm -r --if-present test",
    "test:training-v2:e2e": "node apps/api/tests/training-v2-stage5-part4-e2e.cjs",
    "test:training:openai:smoke": "pnpm --filter @platforma/api test:training:openai:smoke",
    "benchmark:training:question-budget": "pnpm build:api && node --env-file-if-exists=.env apps/api/tests/training-v2-question-budget-benchmark.cjs",
    "benchmark:training:luna-terra": "pnpm build:api && node --env-file-if-exists=.env apps/api/tests/training-v2-luna-terra-benchmark.cjs",
    "benchmark:training:evaluator": "pnpm build:api && node --env-file-if-exists=.env apps/api/tests/training-v2-evaluator-efficiency-benchmark.cjs",
    "training:webhook:status": "node --env-file-if-exists=.env apps/api/scripts/training-telegram-webhook.cjs status",
    "training:webhook:register": "node --env-file-if-exists=.env apps/api/scripts/training-telegram-webhook.cjs register",
    "training:webhook:delete": "node --env-file-if-exists=.env apps/api/scripts/training-telegram-webhook.cjs delete",
    "training:worker:predeploy": "node --env-file-if-exists=.env apps/api/scripts/training-voice-worker-predeploy.cjs",
    "feed-import:preview": "pnpm --filter @platforma/feed-import run preview",
    "feed-import:run": "pnpm --filter @platforma/feed-import run run",
    "wp-import:preview": "pnpm --filter @platforma/wp-import run preview",
    "wp-import:repair:preview": "pnpm --filter @platforma/wp-import run repair:preview",
    "wp-import:repair:run": "pnpm --filter @platforma/wp-import run repair:run",
    "wp-import:run": "pnpm --filter @platforma/wp-import run run"
  }
}
