# Copy to .env.staging, chmod 600 and replace every placeholder.
# Never reuse production database, buckets, Telegram bot, OpenAI project or users.
COMPOSE_PROJECT_NAME=platforma-staging
NODE_ENV=production
DEPLOYMENT_ENV=staging
TRAINING_MODULE_ENABLED=false

POSTGRES_DB=platforma_staging
POSTGRES_USER=platforma_staging
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_POSTGRES_PASSWORD
DATABASE_URL=postgresql://platforma_staging:REPLACE_WITH_STAGING_POSTGRES_PASSWORD@postgres:5432/platforma_staging?schema=public
STAGING_DATABASE_ALLOWED_HOSTS=REPLACE_WITH_STAGING_DATABASE_HOSTS
STAGING_DATABASE_NAME=platforma_staging
KNOWN_PRODUCTION_DATABASE_IDENTITIES=REPLACE_WITH_PRODUCTION_HOST_PORT_DATABASE_IDENTITIES

MINIO_ROOT_USER=REPLACE_WITH_STAGING_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_STAGING_MINIO_PASSWORD
MINIO_BUCKET=platforma-staging
TRAINING_DOCUMENT_BUCKET=platforma-training-staging-private
TRAINING_AUDIO_BUCKET=platforma-training-audio-staging-private
KNOWN_PRODUCTION_BUCKETS=REPLACE_WITH_PRODUCTION_BUCKET_NAMES
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.staging.your-domain.ru
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_STAGING_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_S3_SECRET_KEY

TELEGRAM_TRANSPORT_MODE=real
TELEGRAM_BOT_TOKEN=REPLACE_WITH_STAGING_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_STAGING_TELEGRAM_BOT_USERNAME
KNOWN_PRODUCTION_TELEGRAM_BOT_USERNAMES=REPLACE_WITH_PRODUCTION_BOT_USERNAMES
TELEGRAM_WEBHOOK_URL=https://api.staging.your-domain.ru/training/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_STAGING_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
TELEGRAM_LINK_TOKEN_COOLDOWN_SECONDS=30
TELEGRAM_LINK_TOKEN_MAX_ISSUES_PER_HOUR=10
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=98304
TELEGRAM_WORKER_POLL_MS=250
TELEGRAM_WORKER_LEASE_MS=30000
TELEGRAM_WORKER_HEARTBEAT_MS=5000
TELEGRAM_WORKER_DRAIN_TIMEOUT_MS=10000

# Phase A: real Telegram + fake OpenAI. Change both values together only
# after the separate billable synthetic smoke gate succeeds.
OPENAI_PROVIDER_MODE=fake
STAGING_ALLOW_FAKE_PROVIDERS=true
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
OPENAI_TRANSCRIPTION_REVIEW_MODEL=gpt-4o-transcribe
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
OPENAI_EVALUATION_REASONING=medium
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_REVIEW_REASONING=high
OPENAI_SMOKE_ENABLED=false

WEB_ORIGIN=https://app.staging.your-domain.ru
PUBLIC_APP_URL=https://app.staging.your-domain.ru
VITE_API_URL=https://api.staging.your-domain.ru
STAGING_PUBLIC_HOSTS=REPLACE_WITH_STAGING_PUBLIC_HOSTS
KNOWN_PRODUCTION_PUBLIC_HOSTS=REPLACE_WITH_PRODUCTION_PUBLIC_HOSTS

JWT_ACCESS_SECRET=REPLACE_WITH_STAGING_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STAGING_REFRESH_SECRET
JWT_MEDIA_SECRET=REPLACE_WITH_STAGING_MEDIA_SECRET
EMAIL_AUTH_SECRET=REPLACE_WITH_STAGING_EMAIL_SECRET
