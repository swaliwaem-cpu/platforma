COMPOSE_PROJECT_NAME=platforma
NODE_ENV=development
DEPLOYMENT_ENV=development
STAGING_ALLOW_FAKE_PROVIDERS=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=platforma
POSTGRES_USER=platforma
POSTGRES_PASSWORD=platforma_password
DATABASE_URL=postgresql://platforma:platforma_password@postgres:5432/platforma?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=platforma
MINIO_ROOT_PASSWORD=platforma_password
MINIO_BUCKET=platforma
TRAINING_DOCUMENT_BUCKET=platforma-training-private
# Local/test default. Production requires a distinct dedicated private bucket
# and fails startup if policy/ACL plus anonymous probes cannot prove privacy.
TRAINING_AUDIO_BUCKET=platforma-training-audio-private
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=platforma
S3_SECRET_ACCESS_KEY=platforma_password
FILE_IMAGE_MAX_SIZE_BYTES=10485760
FILE_PDF_MAX_SIZE_BYTES=52428800
TRAINING_MAX_DOCUMENT_BYTES=52428800
TRAINING_MAX_DOCUMENT_UNCOMPRESSED_BYTES=209715200
TRAINING_MAX_DOCUMENT_ENTRY_BYTES=52428800
TRAINING_MAX_DOCUMENT_ZIP_ENTRIES=5000
TRAINING_MAX_EXTRACTED_CHARACTERS=1000000
TRAINING_MAX_EXTRACTION_SEGMENTS=50000
TRAINING_DOCUMENT_EXTRACTION_TIMEOUT_MS=30000
TRAINING_DOCUMENT_JOB_POLL_MS=2000
TRAINING_AUDIO_MAX_BYTES=20971520
TRAINING_AUDIO_MAX_ANSWER_BYTES=83886080
TRAINING_AUDIO_MAX_SEGMENTS=32
TRAINING_AUDIO_MAX_DURATION_SECONDS=600
TRAINING_AUDIO_DOWNLOAD_TIMEOUT_MS=30000
TRAINING_FFMPEG_TIMEOUT_MS=90000
TRAINING_AUDIO_WORKER_POLL_MS=500
TRAINING_AUDIO_WORKER_CONCURRENCY=2
TRAINING_AUDIO_WORKER_LEASE_MS=120000
TRAINING_AUDIO_WORKER_HEARTBEAT_MS=5000
TRAINING_AUDIO_WORKER_DRAIN_TIMEOUT_MS=30000
TRAINING_AUDIO_TEMP_DIR=/tmp/platforma-training-audio
# 0 means indefinite retention; other values are rejected at stage 7.
TRAINING_AUDIO_RETENTION_DAYS=0
OPENAI_PROVIDER_MODE=fake
# Production real mode requires a non-placeholder key and all six
# model/reasoning variables explicitly; these are development defaults only.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
OPENAI_TRANSCRIPTION_REVIEW_MODEL=gpt-4o-transcribe
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
OPENAI_EVALUATION_REASONING=medium
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_REVIEW_REASONING=high
OPENAI_TRANSCRIPTION_TIMEOUT_MS=60000
OPENAI_EVALUATION_TIMEOUT_MS=120000
OPENAI_TRANSCRIPTION_MAX_RETRIES=2
OPENAI_EVALUATION_MAX_RETRIES=2
OPENAI_TRANSCRIPTION_MAX_BYTES=25165824
OPENAI_MAX_RESPONSE_BYTES=2097152
OPENAI_EVALUATION_MAX_OUTPUT_TOKENS=4096
# Billable smoke remains disabled unless explicitly enabled for one manual run.
OPENAI_SMOKE_ENABLED=false

API_PORT=3000
WEB_PORT=5173
# Enables the same feed scheduler used in production: on API start and every 2 hours.
FEED_AUTO_IMPORT_ENABLED=true
# Training foundation is opt-in until the module is ready for rollout.
TRAINING_MODULE_ENABLED=false
# Local development defaults. Production must use .env.production together
# with docker-compose.production.yml; do not reuse these fake/localhost values.
TELEGRAM_TRANSPORT_MODE=fake
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=platforma_training_bot
TELEGRAM_WEBHOOK_URL=http://localhost:3000/training/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
TELEGRAM_LINK_TOKEN_COOLDOWN_SECONDS=30
TELEGRAM_LINK_TOKEN_MAX_ISSUES_PER_HOUR=10
TELEGRAM_WEBHOOK_MAX_BODY_BYTES=98304
TELEGRAM_WORKER_POLL_MS=250
TELEGRAM_WORKER_LEASE_MS=30000
TELEGRAM_WORKER_HEARTBEAT_MS=5000
TELEGRAM_WORKER_DRAIN_TIMEOUT_MS=10000
# Local development uses the API origin directly.
# Production behind nginx should use same-origin routing: VITE_API_URL=/api.
VITE_API_URL=http://localhost:3000
# Optional: enables the full Yandex JS API mode. Without it maps use the no-key widget mode.
VITE_YANDEX_MAPS_API_KEY=
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=platforma_admin_password
ADMIN_PASSWORD_HASH=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_MEDIA_SECRET=change-me-media-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MEDIA_TOKEN_TTL_MINUTES=200
EMAIL_AUTH_SECRET=change-me-email-auth-secret
EMAIL_AUTH_TTL_MINUTES=15
REFRESH_COOKIE_NAME=platforma_refresh_token
MEDIA_COOKIE_NAME=platforma_media_token

SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@fluffywhite.moscow
SMTP_PASSWORD=
MAIL_FROM=Platforma <no-reply@fluffywhite.moscow>

# WordPress import for API container.
# For local CLI usage see tools/wp-import/.env.example.
WP_DB_HOST=host.docker.internal
WP_DB_PORT=3306
WP_DB_SOCKET=
WP_DB_USER=wp_readonly
WP_DB_PASSWORD=password
WP_DB_NAME=local
WP_TABLE_PREFIX=wp_
WP_IMPORT_PROFILE=residential
WP_IMPORT_LIMIT=10
WP_UPLOADS_HOST_PATH=/absolute/path/to/wp-content/uploads
WP_UPLOADS_PATH=/wp-uploads
