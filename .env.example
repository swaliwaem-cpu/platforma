COMPOSE_PROJECT_NAME=platforma

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=platforma
POSTGRES_USER=platforma
POSTGRES_PASSWORD=platforma_password
DATABASE_URL=postgresql://platforma:platforma_password@postgres:5432/platforma?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=platforma
MINIO_ROOT_PASSWORD=platforma_password
MINIO_BUCKET=platforma
TRAINING_AUDIO_BUCKET=platforma-training-audio
TRAINING_MATERIAL_BUCKET=platforma-training-materials
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=platforma
S3_SECRET_ACCESS_KEY=platforma_password
FILE_IMAGE_MAX_SIZE_BYTES=10485760
FILE_PDF_MAX_SIZE_BYTES=52428800

# Training V2. Keep real credentials only in an untracked env file.
TRAINING_MODULE_ENABLED=true
# Assistant stays disabled until the pilot is enabled deliberately. Tests and local runs default to fake AI.
ASSISTANT_MODULE_ENABLED=false
ASSISTANT_ROLLOUT_STAGE=ADMINS
# Comma-separated UUIDs of the bounded ordinary-user pilot cohort; rollout preflight requires 8-12.
ASSISTANT_PILOT_USER_IDS=
ASSISTANT_FAKE_STEP_DELAY_MS=120
ASSISTANT_AI_MODE=fake
ASSISTANT_QUERY_PLANNER_LIVE=false
ASSISTANT_OPENAI_TIMEOUT_MS=20000
ASSISTANT_MODEL_REQUESTS_PER_MINUTE=60
ASSISTANT_MODEL_REQUESTS_PER_DAY=5000
ASSISTANT_MODEL_DAILY_BUDGET_USD=
ASSISTANT_PAID_CALLS_CONFIRMED=false
ASSISTANT_SOURCE_DISCOVERY_MODEL=gpt-5.6-luna
ASSISTANT_SOURCE_DISCOVERY_TIMEOUT_MS=60000
ASSISTANT_SOURCE_DISCOVERY_MAX_PROVIDER_CALLS=35
ASSISTANT_SOURCE_DISCOVERY_MAX_TERRA_FALLBACKS=2
ASSISTANT_SOURCE_DISCOVERY_LOCAL_APPLY=false
# Geo provider stays fake locally. LocationIQ mode requires an explicit plan budget and cache retention.
ASSISTANT_GEO_PROVIDER_ENABLED=false
ASSISTANT_GEO_PROVIDER_MODE=fake
LOCATIONIQ_API_KEY=
LOCATIONIQ_API_URL=https://us1.locationiq.com/v1/search
ASSISTANT_GEO_PROVIDER_TIMEOUT_MS=3000
ASSISTANT_GEO_PROVIDER_MAX_RETRIES=1
ASSISTANT_GEO_PROVIDER_RPS=1
ASSISTANT_GEO_PROVIDER_REQUESTS_PER_MINUTE=60
ASSISTANT_GEO_PROVIDER_DAILY_BUDGET=10000
ASSISTANT_OVERPASS_ENABLED=false
ASSISTANT_OVERPASS_URL=https://overpass-api.de/api/interpreter
ASSISTANT_OVERPASS_TIMEOUT_MS=5000
ASSISTANT_OVERPASS_MAX_RESPONSE_BYTES=1048576
ASSISTANT_OVERPASS_RPS=1
ASSISTANT_OVERPASS_CIRCUIT_FAILURE_THRESHOLD=3
ASSISTANT_OVERPASS_CIRCUIT_OPEN_MS=60000
ASSISTANT_GEO_CACHE_TTL_SECONDS=86400
ASSISTANT_GEO_CIRCUIT_FAILURE_THRESHOLD=3
ASSISTANT_GEO_CIRCUIT_OPEN_MS=60000
ASSISTANT_GEO_RADIUS_MIN_METERS=100
ASSISTANT_GEO_RADIUS_MAX_METERS=20000
# Source worker uses the opt-in Compose profile `assistant-external`. Keep it disabled until sources are registered.
ASSISTANT_EXTERNAL_CONNECTORS_ENABLED=false
ASSISTANT_SOURCE_WORKER_ENABLED=false
ASSISTANT_SOURCE_FETCH_TIMEOUT_MS=10000
ASSISTANT_SOURCE_MAX_RESPONSE_BYTES=5242880
ASSISTANT_SOURCE_MAX_REDIRECTS=3
ASSISTANT_SOURCE_BROWSER_FALLBACK_ENABLED=false
ASSISTANT_SOURCE_BROWSER_TIMEOUT_MS=20000
ASSISTANT_SOURCE_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ASSISTANT_RETRIEVAL_CACHE_TTL_MS=21600000
# Use fake locally. Production must use disabled or a benchmark-selected OpenAI model/dimension pair.
ASSISTANT_EMBEDDING_MODE=fake
ASSISTANT_EMBEDDING_MODEL=
ASSISTANT_EMBEDDING_DIMENSIONS=
ASSISTANT_EMBEDDING_BENCHMARK_WINNER=
ASSISTANT_EMBEDDING_TIMEOUT_MS=20000
# Paid benchmark is manual-only: set the flag and an explicit JSON candidate list for one bounded run.
ASSISTANT_EMBEDDING_BENCHMARK_ENABLED=false
ASSISTANT_EMBEDDING_BENCHMARK_CANDIDATES=
TELEGRAM_TRANSPORT_MODE=fake
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_REQUEST_TIMEOUT_MS=5000
TRAINING_AUDIO_MAX_DURATION_SECONDS=1800
TRAINING_AUDIO_MAX_SEGMENT_BYTES=20971520
TRAINING_AUDIO_MAX_TOTAL_INPUT_BYTES=62914560
TRAINING_AUDIO_PROVIDER_UPLOAD_MAX_BYTES=25165824
TRAINING_AUDIO_MAX_BUFFERED_BYTES=67108864
TRAINING_AUDIO_OPUS_BITRATE_BPS=32000
TRAINING_AUDIO_CHUNK_OVERLAP_SECONDS=2
TRAINING_FFMPEG_TIMEOUT_MS=120000
TRAINING_FFMPEG_CONCURRENCY=1
TRAINING_VOICE_WORKER_ENABLED=true
TRAINING_MATERIAL_WORKER_ENABLED=true
TRAINING_MATERIAL_WORKER_CONCURRENCY=1
TRAINING_MATERIAL_WORKER_SHUTDOWN_DRAIN_MS=10000
TRAINING_VOICE_WORKER_CONCURRENCY=3
TRAINING_VOICE_WORKER_SHUTDOWN_DRAIN_MS=10000
TRAINING_AI_MODE=fake
TRAINING_CROSS_PROJECT_GENERATION_REUSE_ENABLED=false
# Enable only after the manual evaluator quality gate passes on real labelled answers.
TRAINING_HARMLESS_EXTRA_ROUTING_ENABLED=false
TRAINING_MATERIAL_MAX_BYTES=26214400
TRAINING_MATERIAL_EXTRACTION_TIMEOUT_MS=60000
TRAINING_MATERIAL_MAX_TEXT_CHARS=2000000
TRAINING_MATERIAL_BROWSER_FALLBACK_ENABLED=false
TRAINING_MATERIAL_BROWSER_TIMEOUT_MS=30000
TRAINING_MATERIAL_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser
TRAINING_MATERIAL_SUGGESTION_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
OPENAI_QUESTION_GENERATION_MODEL=gpt-5.6-terra
OPENAI_QUESTION_GENERATION_LUNA_MODEL=gpt-5.6-luna
OPENAI_QUESTION_GENERATION_STRATEGY=terra_only
OPENAI_QUESTION_GENERATION_REASONING=low
OPENAI_QUESTION_GENERATION_SOURCE_MAX_CHARS=30000
OPENAI_QUESTION_GENERATION_MAX_OUTPUT_TOKENS=7000
OPENAI_QUESTION_GENERATION_LEASE_MS=180000
OPENAI_EVALUATOR_MODEL=gpt-5.6-terra
OPENAI_EVALUATOR_REASONING=medium
OPENAI_EVALUATOR_MAIN_REASONING=
OPENAI_EVALUATOR_FOLLOW_UP_REASONING=
OPENAI_TRANSCRIPTION_TIMEOUT_MS=60000
OPENAI_EVALUATION_TIMEOUT_MS=120000
OPENAI_TRANSCRIPTION_MAX_RETRIES=2
OPENAI_EVALUATION_MAX_RETRIES=2
OPENAI_EVALUATION_MAX_OUTPUT_TOKENS=4000
OPENAI_EVALUATION_EVIDENCE_MAX_CHARS=500
OPENAI_EVALUATION_EXPLANATION_MAX_CHARS=1000
OPENAI_EVALUATION_SUMMARY_MAX_CHARS=1000
OPENAI_EVALUATION_UNSUPPORTED_CLAIMS_MAX=20
OPENAI_EVALUATION_UNSUPPORTED_CLAIM_MAX_CHARS=500

API_PORT=3000
WEB_PORT=5173
# Enables the same feed scheduler used in production: on API start and every 2 hours.
FEED_AUTO_IMPORT_ENABLED=true
# Local development uses the API origin directly.
# Production behind nginx should use same-origin routing: VITE_API_URL=/api.
VITE_API_URL=http://localhost:3000
MAP_PROVIDER_ENABLED=true
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_API_URL=https://api.openrouteservice.org
OPENROUTESERVICE_TIMEOUT_MS=5000
OPENROUTESERVICE_MAX_RETRIES=2
OPENROUTESERVICE_CACHE_STALE_AFTER_MS=15552000000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=platforma_admin_password
ADMIN_PASSWORD_HASH=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_MEDIA_SECRET=change-me-media-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MEDIA_TOKEN_TTL_MINUTES=200
EMAIL_AUTH_SECRET=change-me-email-auth-secret
EMAIL_AUTH_TTL_MINUTES=15
REFRESH_COOKIE_NAME=platforma_refresh_token
MEDIA_COOKIE_NAME=platforma_media_token

SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@fluffywhite.moscow
SMTP_PASSWORD=
MAIL_FROM=Platforma <no-reply@fluffywhite.moscow>

# WordPress import for API container.
# For local CLI usage see tools/wp-import/.env.example.
WP_DB_HOST=host.docker.internal
WP_DB_PORT=3306
WP_DB_SOCKET=
WP_DB_USER=wp_readonly
WP_DB_PASSWORD=password
WP_DB_NAME=local
WP_TABLE_PREFIX=wp_
WP_IMPORT_PROFILE=residential
WP_IMPORT_LIMIT=10
WP_UPLOADS_HOST_PATH=/absolute/path/to/wp-content/uploads
WP_UPLOADS_PATH=/wp-uploads
