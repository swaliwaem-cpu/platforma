# Training V2 Stage 2. Keep real credentials only in an untracked env file.
TELEGRAM_TRANSPORT_MODE=fake
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUEST_TIMEOUT_MS=5000
TRAINING_FFMPEG_TIMEOUT_MS=30000
TRAINING_VOICE_WORKER_ENABLED=true

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=platforma_admin_password
