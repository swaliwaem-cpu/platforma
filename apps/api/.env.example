NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql://platforma:platforma_password@localhost:5432/platforma?schema=public
REDIS_URL=redis://localhost:6379
TRAINING_MODULE_ENABLED=false
# Local/test defaults only. Production uses the root .env.production file and
# docker-compose.production.yml, which force real transport and required values.
TELEGRAM_TRANSPORT_MODE=fake
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=platforma_training_bot
TELEGRAM_WEBHOOK_URL=http://localhost:3000/training/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=15
TELEGRAM_WORKER_POLL_MS=250
TELEGRAM_WORKER_LEASE_MS=30000
TELEGRAM_WORKER_HEARTBEAT_MS=5000
TELEGRAM_WORKER_DRAIN_TIMEOUT_MS=10000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=platforma
S3_SECRET_ACCESS_KEY=platforma_password
MINIO_BUCKET=platforma
TRAINING_DOCUMENT_BUCKET=platforma-training-private
TRAINING_AUDIO_BUCKET=platforma-training-audio-private
FILE_IMAGE_MAX_SIZE_BYTES=10485760
FILE_PDF_MAX_SIZE_BYTES=52428800
TRAINING_MAX_DOCUMENT_BYTES=52428800
TRAINING_MAX_DOCUMENT_UNCOMPRESSED_BYTES=209715200
TRAINING_MAX_DOCUMENT_ENTRY_BYTES=52428800
TRAINING_MAX_DOCUMENT_ZIP_ENTRIES=5000
TRAINING_MAX_EXTRACTED_CHARACTERS=1000000
TRAINING_MAX_EXTRACTION_SEGMENTS=50000
TRAINING_DOCUMENT_EXTRACTION_TIMEOUT_MS=30000
TRAINING_DOCUMENT_JOB_POLL_MS=2000
TRAINING_AUDIO_MAX_BYTES=20971520
TRAINING_AUDIO_MAX_ANSWER_BYTES=83886080
TRAINING_AUDIO_MAX_SEGMENTS=32
TRAINING_AUDIO_MAX_DURATION_SECONDS=600
TRAINING_AUDIO_DOWNLOAD_TIMEOUT_MS=30000
TRAINING_FFMPEG_TIMEOUT_MS=90000
TRAINING_TRANSCRIPTION_TIMEOUT_MS=30000
TRAINING_AUDIO_WORKER_POLL_MS=500
TRAINING_AUDIO_WORKER_CONCURRENCY=2
TRAINING_AUDIO_WORKER_LEASE_MS=120000
TRAINING_AUDIO_WORKER_HEARTBEAT_MS=5000
TRAINING_AUDIO_WORKER_DRAIN_TIMEOUT_MS=30000
TRAINING_AUDIO_TEMP_DIR=/tmp/platforma-training-audio
# 0 means indefinite retention; other values are rejected at stage 7.
TRAINING_AUDIO_RETENTION_DAYS=0

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=platforma_admin_password
ADMIN_PASSWORD_HASH=

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_MEDIA_SECRET=change-me-media-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MEDIA_TOKEN_TTL_MINUTES=200
EMAIL_AUTH_SECRET=change-me-email-auth-secret
EMAIL_AUTH_TTL_MINUTES=15
REFRESH_COOKIE_NAME=platforma_refresh_token
MEDIA_COOKIE_NAME=platforma_media_token

SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@fluffywhite.moscow
SMTP_PASSWORD=
MAIL_FROM=Platforma <no-reply@fluffywhite.moscow>
