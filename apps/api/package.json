{
  "name": "@platforma/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:seed": "pnpm build && node dist/prisma/seed.js",
    "dev": "pnpm build && node dist/main.js",
    "media:variants:backfill": "pnpm build && node dist/files/backfill-image-variants.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "start": "node dist/main.js",
    "test": "pnpm build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.19",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/nodemailer": "^8.0.0",
    "prisma": "6.19.3",
    "typescript": "6.0.3"
  }
}
