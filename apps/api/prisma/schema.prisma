  projectId            String                @map("project_id") @db.Uuid
  projectVersionId     String                @map("project_version_id") @db.Uuid
  attemptNumber        Int                   @map("attempt_number")
  status               TrainingAttemptStatus @default(STARTED)
  isConsumed           Boolean               @default(true) @map("is_consumed")
  startedAt            DateTime              @default(now()) @map("started_at")
  expiresAt            DateTime              @map("expires_at")
  graceExpiresAt       DateTime              @map("grace_expires_at")
  completedAt          DateTime?             @map("completed_at")
  settingsSnapshotJson Json                  @map("settings_snapshot_json")
  aiScore              Decimal?              @map("ai_score") @db.Decimal(6, 2)
  serverScore          Decimal?              @map("server_score") @db.Decimal(6, 2)
  adminScore           Decimal?              @map("admin_score") @db.Decimal(6, 2)
  finalScore           Decimal?              @map("final_score") @db.Decimal(6, 2)
  passStatus           TrainingPassStatus    @default(PENDING) @map("pass_status")
  reviewStatus         TrainingReviewStatus  @default(NOT_REQUIRED) @map("review_status")
  summary              String?               @db.VarChar(2000)
  totalDurationSeconds Int?                  @map("total_duration_seconds")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  project          TrainingProject           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectVersion   TrainingProjectVersion    @relation(fields: [projectVersionId], references: [id], onDelete: Restrict)
  attemptQuestions TrainingAttemptQuestion[]
  reviews          TrainingResultReview[]

  @@unique([userId, projectId, attemptNumber])
  @@index([userId, status])
  @@index([projectId, status])
  @@index([projectVersionId])
  @@index([completedAt])
  @@index([reviewStatus, completedAt])
  @@map("training_attempts")
}

model TrainingAttemptQuestion {
  id                    String                        @id @default(uuid()) @db.Uuid
  attemptId             String                        @map("attempt_id") @db.Uuid
  questionId            String                        @map("question_id") @db.Uuid
  sequence              Int
  status                TrainingAttemptQuestionStatus @default(PENDING)
  presentedAt           DateTime?                     @map("presented_at")
  firstSegmentAt        DateTime?                     @map("first_segment_at")
  finishedAt            DateTime?                     @map("finished_at")
  responseTimeSeconds   Int?                          @map("response_time_seconds")
  answerDurationSeconds Int?                          @map("answer_duration_seconds")
  selectionRandomIndex  Int?                          @map("selection_random_index")
  selectionMetadataJson Json?                         @map("selection_metadata_json")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  attempt  TrainingAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer   TrainingAnswer?

  @@unique([attemptId, sequence])
  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([attemptId, status])
  @@map("training_attempt_questions")
}

model TrainingAnswer {
  id                     String               @id @default(uuid()) @db.Uuid
  attemptQuestionId      String               @unique @map("attempt_question_id") @db.Uuid
  status                 TrainingAnswerStatus @default(COLLECTING)
  combinedTranscript     String?              @map("combined_transcript")
  normalizedLanguage     String?              @map("normalized_language") @db.VarChar(16)
  acousticMetricsJson    Json?                @map("acoustic_metrics_json")
  transcriptionProvider  String?              @map("transcription_provider") @db.VarChar(64)
  transcriptionModel     String?              @map("transcription_model") @db.VarChar(120)
  transcriptionRequestId String?              @map("transcription_request_id") @db.VarChar(160)
  processingStartedAt    DateTime?            @map("processing_started_at")
  processingFinishedAt   DateTime?            @map("processing_finished_at")
  errorCode              String?              @map("error_code") @db.VarChar(120)
  errorMessage           String?              @map("error_message") @db.VarChar(2000)
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  attemptQuestion TrainingAttemptQuestion    @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  voiceSegments   TrainingVoiceSegment[]
  evaluations     TrainingAnswerEvaluation[]

  @@index([status, updatedAt])
  @@map("training_answers")
}

model TrainingVoiceSegment {
  id                    String   @id @default(uuid()) @db.Uuid
  answerId              String   @map("answer_id") @db.Uuid
  segmentIndex          Int      @map("segment_index")
  telegramUpdateId      BigInt   @unique @map("telegram_update_id")
  telegramMessageId     BigInt   @map("telegram_message_id")
  telegramChatId        BigInt   @map("telegram_chat_id")
  telegramFileId        String   @map("telegram_file_id") @db.VarChar(256)
  fileUniqueId          String   @map("file_unique_id") @db.VarChar(256)
  originalStorageBucket String?  @map("original_storage_bucket") @db.VarChar(255)
  originalStorageKey    String?  @map("original_storage_key") @db.VarChar(1024)
  mimeType              String?  @map("mime_type") @db.VarChar(120)
  sizeBytes             BigInt?  @map("size_bytes")
  durationSeconds       Int?     @map("duration_seconds")
  receivedAt            DateTime @default(now()) @map("received_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  answer TrainingAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([answerId, segmentIndex])
  @@unique([telegramChatId, telegramMessageId])
  @@unique([originalStorageBucket, originalStorageKey])
  @@index([answerId, receivedAt])
  @@index([fileUniqueId])
  @@map("training_voice_segments")
}

model TrainingAnswerEvaluation {
  id                   String    @id @default(uuid()) @db.Uuid
  answerId             String    @map("answer_id") @db.Uuid
  evaluationNumber     Int       @default(1) @map("evaluation_number")
  actualModelId        String    @map("actual_model_id") @db.VarChar(120)
  reasoningEffort      String?   @map("reasoning_effort") @db.VarChar(32)
  promptVersion        String    @map("prompt_version") @db.VarChar(64)
  schemaVersion        String    @map("schema_version") @db.VarChar(64)
  rubricVersion        String    @map("rubric_version") @db.VarChar(64)
  structuredResultJson Json      @map("structured_result_json")
  aiSuggestedScore     Decimal   @map("ai_suggested_score") @db.Decimal(6, 2)
  serverScore          Decimal   @map("server_score") @db.Decimal(6, 2)
  summary              String?   @db.VarChar(2000)
  requiresReview       Boolean   @default(false) @map("requires_review")
  reviewReasonsJson    Json      @default("[]") @map("review_reasons_json")
  providerUsageJson    Json?     @map("provider_usage_json")
  latencyMs            Int?      @map("latency_ms")
  requestId            String?   @unique @map("request_id") @db.VarChar(160)
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  answer          TrainingAnswer           @relation(fields: [answerId], references: [id], onDelete: Cascade)
  scoreComponents TrainingScoreComponent[]

  @@unique([answerId, evaluationNumber])
  @@index([answerId, createdAt])
  @@index([requiresReview])
  @@map("training_answer_evaluations")
}

model TrainingScoreComponent {
  id            String               @id @default(uuid()) @db.Uuid
  evaluationId  String               @map("evaluation_id") @db.Uuid
  criterionId   String?              @map("criterion_id") @db.Uuid
  factId        String?              @map("fact_id") @db.Uuid
  componentKey  String               @map("component_key") @db.VarChar(160)
  title         String?              @db.VarChar(240)
  awardedPoints Decimal              @map("awarded_points") @db.Decimal(6, 2)
  maxPoints     Decimal              @map("max_points") @db.Decimal(6, 2)
  factVerdict   TrainingFactVerdict? @map("fact_verdict")
  evidenceJson  Json?                @map("evidence_json")
  penaltyPoints Decimal              @default(0) @map("penalty_points") @db.Decimal(6, 2)
  createdAt     DateTime             @default(now()) @map("created_at")

  evaluation TrainingAnswerEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  TrainingEvaluationCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  fact       TrainingFact?                @relation(fields: [factId], references: [id], onDelete: SetNull)

  @@unique([evaluationId, componentKey])
  @@index([criterionId])
  @@index([factId])
  @@map("training_score_components")
}

model TrainingResultReview {
  id                             String               @id @default(uuid()) @db.Uuid
  attemptId                      String               @map("attempt_id") @db.Uuid
  reviewerId                     String               @map("reviewer_id") @db.Uuid
  reviewNumber                   Int                  @default(1) @map("review_number")
  previousFinalScore             Decimal?             @map("previous_final_score") @db.Decimal(6, 2)
  adminScore                     Decimal?             @map("admin_score") @db.Decimal(6, 2)
  finalScore                     Decimal              @map("final_score") @db.Decimal(6, 2)
  decision                       TrainingReviewStatus
  comment                        String               @db.VarChar(2000)
  unsupportedClaimsDecisionsJson Json                 @default("[]") @map("unsupported_claims_decisions_json")
  reviewedAt                     DateTime             @default(now()) @map("reviewed_at")
  createdAt                      DateTime             @default(now()) @map("created_at")

  attempt  TrainingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewer User            @relation("TrainingResultReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([attemptId, reviewNumber])
  @@index([reviewerId, reviewedAt])
  @@index([attemptId, reviewedAt])
  @@map("training_result_reviews")
}

model TrainingProcessedUpdate {
  id          String                        @id @default(uuid()) @db.Uuid
  updateId    BigInt                        @unique @map("update_id")
  status      TrainingProcessedUpdateStatus @default(RECEIVED)
  updateType  String?                       @map("update_type") @db.VarChar(64)
  payloadHash String?                       @map("payload_hash") @db.VarChar(128)
  receivedAt  DateTime                      @default(now()) @map("received_at")
  processedAt DateTime?                     @map("processed_at")
  errorCode   String?                       @map("error_code") @db.VarChar(120)
  createdAt   DateTime                      @default(now()) @map("created_at")
  updatedAt   DateTime                      @updatedAt @map("updated_at")

  @@index([status, receivedAt])
  @@index([processedAt])
  @@map("training_processed_updates")
}

model TrainingJob {
  id               String            @id @default(uuid()) @db.Uuid
  kind             TrainingJobKind
  status           TrainingJobStatus @default(PENDING)
  payloadJson      Json              @map("payload_json")
  idempotencyKey   String            @unique @map("idempotency_key") @db.VarChar(160)
  runAt            DateTime          @default(now()) @map("run_at")
  attempts         Int               @default(0)
  maxAttempts      Int               @default(3) @map("max_attempts")
  lockOwner        String?           @map("lock_owner") @db.VarChar(160)
  lockedAt         DateTime?         @map("locked_at")
  heartbeatAt      DateTime?         @map("heartbeat_at")
  lastErrorCode    String?           @map("last_error_code") @db.VarChar(120)
  lastErrorMessage String?           @map("last_error_message") @db.VarChar(2000)
  errorDetailsJson Json?             @map("error_details_json")
  finishedAt       DateTime?         @map("finished_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([status, runAt, createdAt])
  @@index([lockedAt])
  @@index([heartbeatAt])
  @@map("training_jobs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(120)
  entityId    String?  @map("entity_id") @db.VarChar(120)
  objectId    String?  @map("object_id") @db.Uuid
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor  User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  object RealEstateObject? @relation("ObjectAuditLogs", fields: [objectId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([objectId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ImportReport {
  id           String       @id @default(uuid()) @db.Uuid
  mode         ImportMode
  status       ImportStatus @default(PENDING)
  source       String       @default("wordpress") @db.VarChar(120)
  startedAt    DateTime     @default(now()) @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  summaryJson  Json?        @map("summary_json")
  warningsJson Json?        @map("warnings_json")
  errorsJson   Json?        @map("errors_json")
  createdById  String?      @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  createdBy User? @relation("ImportReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([mode, status])
  @@index([createdById])
  @@index([createdAt])
  @@map("import_reports")
}
