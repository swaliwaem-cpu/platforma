generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE      @map("active")
  BLOCKED     @map("blocked")
  INVITED     @map("invited")
  DEACTIVATED @map("deactivated")

  @@map("user_status")
}

enum ObjectStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("object_status")
}

enum RealEstateObjectType {
  RESIDENTIAL @map("residential")
  COMMERCIAL  @map("commercial")

  @@map("real_estate_object_type")
}

enum LocationType {
  AREA     @map("area")
  DISTRICT @map("district")
  CUSTOM   @map("custom")

  @@map("location_type")
}

enum FileStorage {
  LOCAL @map("local")
  MINIO @map("minio")

  @@map("file_storage")
}

enum FileVariantKind {
  THUMBNAIL @map("thumbnail")
  CARD      @map("card")
  DETAIL    @map("detail")

  @@map("file_variant_kind")
}

enum ObjectFileType {
  PRESENTATION @map("presentation")
  FLOOR_PLAN   @map("floor_plan")
  DOCUMENT     @map("document")
  OTHER        @map("other")

  @@map("object_file_type")
}

enum ObjectImageSection {
  ARCHITECTURE @map("architecture")
  INTERIORS    @map("interiors")
  FILLING      @map("filling")

  @@map("object_image_section")
}

enum ImportMode {
  PREVIEW @map("preview")
  RUN     @map("run")

  @@map("import_mode")
}

enum ImportStatus {
  PENDING @map("pending")
  SUCCESS @map("success")
  PARTIAL @map("partial")
  FAILED  @map("failed")

  @@map("import_status")
}

enum CatalogQuickLinkType {
  DEVELOPER   @map("developer")
  KRT         @map("krt")
  SALES_START @map("sales_start")

  @@map("catalog_quick_link_type")
}

enum FeedFormat {
  YANDEX_REALTY @map("yandex_realty")
  CIAN_XML      @map("cian_xml")
  AVITO_XML     @map("avito_xml")
  FSK_XML       @map("fsk_xml")
  TEKTA_XML     @map("tekta_xml")

  @@map("feed_format")
}

enum FeedSourceKind {
  URL       @map("url")
  FILE      @map("file")
  INDEX_URL @map("index_url")

  @@map("feed_source_kind")
}

enum FeedUnitType {
  RESIDENTIAL @map("residential")
  COMMERCIAL  @map("commercial")

  @@map("feed_unit_type")
}

enum FeedUnitStatus {
  AVAILABLE @map("available")
  BOOKED    @map("booked")
  RESERVED  @map("reserved")
  SOLD      @map("sold")
  ARCHIVED  @map("archived")
  UNKNOWN   @map("unknown")

  @@map("feed_unit_status")
}

enum ProjectPresentationDocumentStatus {
  PENDING
  RUNNING
  READY
  FAILED

  @@map("project_presentation_document_status")
}

enum TrainingProjectStatus {
  DRAFT    @map("draft")
  OPEN     @map("open")
  CLOSED   @map("closed")
  ARCHIVED @map("archived")

  @@map("training_project_status")
}

enum TrainingVersionStatus {
  DRAFT      @map("draft")
  PUBLISHED  @map("published")
  SUPERSEDED @map("superseded")

  @@map("training_version_status")
}

enum TrainingQuestionType {
  MAIN      @map("main")
  FOLLOW_UP @map("follow_up")

  @@map("training_question_type")
}

enum TrainingAttemptStatus {
  STARTED              @map("started")
  AWAITING_MAIN        @map("awaiting_main")
  PROCESSING_MAIN      @map("processing_main")
  AWAITING_FOLLOW_UP   @map("awaiting_follow_up")
  PROCESSING_FOLLOW_UP @map("processing_follow_up")
  FINALIZING           @map("finalizing")
  COMPLETED            @map("completed")
  REQUIRES_REVIEW      @map("requires_review")
  EXPIRED              @map("expired")
  TECHNICAL_FAILURE    @map("technical_failure")

  @@map("training_attempt_status")
}

enum TrainingAttemptQuestionStatus {
  PENDING         @map("pending")
  PRESENTED       @map("presented")
  COLLECTING      @map("collecting")
  LOCKED          @map("locked")
  PROCESSING      @map("processing")
  SCORED          @map("scored")
  SKIPPED_TIMEOUT @map("skipped_timeout")

  @@map("training_attempt_question_status")
}

enum TrainingAnswerStatus {
  COLLECTING   @map("collecting")
  READY        @map("ready")
  DOWNLOADING  @map("downloading")
  TRANSCRIBING @map("transcribing")
  EVALUATING   @map("evaluating")
  SCORED       @map("scored")
  FAILED       @map("failed")

  @@map("training_answer_status")
}

enum TrainingFactVerdict {
  CORRECT     @map("correct")
  PARTIAL     @map("partial")
  MISSING     @map("missing")
  INCORRECT   @map("incorrect")
  UNSUPPORTED @map("unsupported")

  @@map("training_fact_verdict")
}

enum TrainingReviewStatus {
  NOT_REQUIRED @map("not_required")
  PENDING      @map("pending")
  APPROVED     @map("approved")
  OVERRIDDEN   @map("overridden")

  @@map("training_review_status")
}

enum TrainingPassStatus {
  PENDING @map("pending")
  PASSED  @map("passed")
  FAILED  @map("failed")

  @@map("training_pass_status")
}

enum TrainingJobStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  DEAD      @map("dead")

  @@map("training_job_status")
}

enum TrainingJobKind {
  PROCESS_TELEGRAM_UPDATE   @map("process_telegram_update")
  TELEGRAM_DOWNLOAD_SEGMENT @map("telegram_download_segment")
  ASSEMBLE_ANSWER_AUDIO     @map("assemble_answer_audio")
  TRANSCRIBE_ANSWER         @map("transcribe_answer")
  ANALYZE_ACOUSTICS         @map("analyze_acoustics")
  EVALUATE_ANSWER           @map("evaluate_answer")
  FINALIZE_ATTEMPT          @map("finalize_attempt")
  SEND_TELEGRAM_MESSAGE     @map("send_telegram_message")
  SEND_TIMER_WARNING        @map("send_timer_warning")
  EXPIRE_ATTEMPT            @map("expire_attempt")
  EXTRACT_SOURCE_DOCUMENT   @map("extract_source_document")

  @@map("training_job_kind")
}

enum TrainingSourceExtractionStatus {
  PENDING           @map("pending")
  PROCESSING        @map("processing")
  READY             @map("ready")
  NEEDS_MANUAL_TEXT @map("needs_manual_text")
  FAILED            @map("failed")

  @@map("training_source_extraction_status")
}

enum TrainingSourceDocumentType {
  PDF  @map("pdf")
  DOCX @map("docx")
  PPTX @map("pptx")
  XLSX @map("xlsx")

  @@map("training_source_document_type")
}

enum TrainingProcessedUpdateStatus {
  RECEIVED   @map("received")
  PROCESSING @map("processing")
  PROCESSED  @map("processed")
  FAILED     @map("failed")

  @@map("training_processed_update_status")
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  email                 String     @unique @db.VarChar(320)
  passwordHash          String     @map("password_hash")
  refreshTokenHash      String?    @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime?  @map("refresh_token_expires_at")
  name                  String?
  brokerPhone           String?    @map("broker_phone") @db.VarChar(64)
  brokerEmail           String?    @map("broker_email") @db.VarChar(320)
  profilePhotoFileId    String?    @map("profile_photo_file_id") @db.Uuid
  status                UserStatus @default(INVITED)
  roleId                String     @map("role_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  role                          Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  profilePhotoFile              File?                          @relation("UserProfilePhoto", fields: [profilePhotoFileId], references: [id], onDelete: SetNull)
  auditLogs                     AuditLog[]                     @relation("AuditActor")
  emailAuthChallenges           EmailAuthChallenge[]
  sessions                      UserSession[]
  importReports                 ImportReport[]                 @relation("ImportReportCreator")
  uploadedFiles                 File[]                         @relation("FileUploader")
  lotPresentationCollections    LotPresentationCollection[]
  lotPresentationDocuments      LotPresentationDocument[]
  lotPresentationWorkspaceItems LotPresentationWorkspaceItem[]
  projectPresentationDrafts     ProjectPresentationDraft[]     @relation("ProjectPresentationDraftOwner")
  projectPresentationDocuments  ProjectPresentationDocument[]  @relation("ProjectPresentationDocumentOwner")
  trainingAttempts              TrainingAttempt[]
  trainingTelegramAccount       TrainingTelegramAccount?
  trainingLinkTokens            TrainingLinkToken[]
  trainingPublishedVersions     TrainingProjectVersion[]       @relation("TrainingVersionPublisher")
  trainingResultReviews         TrainingResultReview[]         @relation("TrainingResultReviewer")

  @@index([roleId])
  @@index([profilePhotoFileId])
  @@index([status])
  @@map("users")
}

model UserSession {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  refreshTokenHash      String   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at")
  lastUsedAt            DateTime @default(now()) @map("last_used_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenExpiresAt])
  @@map("user_sessions")
}

model EmailAuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.VarChar(320)
  tokenHash  String    @unique @map("token_hash")
  codeHash   String    @map("code_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, codeHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("email_auth_challenges")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Developer {
  id             String   @id @default(uuid()) @db.Uuid
  wpTermId       Int?     @unique @map("wp_term_id")
  name           String   @unique
  normalizedName String?  @unique @map("normalized_name")
  slug           String?  @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  objects           RealEstateObject[]
  catalogQuickLinks CatalogQuickLink[]
  feedSources       FeedSource[]

  @@map("developers")
}

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  wpTermId  Int?         @unique @map("wp_term_id")
  name      String
  slug      String
  type      LocationType @default(CUSTOM)
  parentId  String?      @map("parent_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  parent         Location?          @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Location[]         @relation("LocationTree")
  primaryObjects RealEstateObject[] @relation("PrimaryObjectLocation")
  objectLinks    ObjectLocation[]

  @@unique([type, slug])
  @@index([parentId])
  @@map("locations")
}

model MetroStation {
  id        String   @id @default(uuid()) @db.Uuid
  wpTermId  Int?     @unique @map("wp_term_id")
  name      String
  slug      String
  lineName  String?  @map("line_name")
  lineColor String?  @map("line_color") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  objectLinks ObjectMetroStation[]

  @@unique([lineName, slug])
  @@index([lineName])
  @@map("metro_stations")
}

model RealEstateObject {
  id                        String               @id @default(uuid()) @db.Uuid
  wpPostId                  Int?                 @unique @map("wp_post_id")
  type                      RealEstateObjectType @default(RESIDENTIAL)
  title                     String
  slug                      String               @unique
  status                    ObjectStatus         @default(DRAFT)
  description               String?
  architectureDescription   String?              @map("architecture_description")
  infrastructureDescription String?              @map("infrastructure_description")
  fillingDescription        String?              @map("filling_description")
  shortDescription          String?              @map("short_description")
  mapName                   String?              @map("map_name") @db.VarChar(16)
  aerotourUrl               String?              @map("aerotour_url") @db.VarChar(2048)
  layoutsUrl                String?              @map("layouts_url") @db.VarChar(2048)
  krtName                   String?              @map("krt_name") @db.VarChar(240)
  apartmentAreaRange        String?              @map("apartment_area_range") @db.VarChar(120)
  ceilingHeight             String?              @map("ceiling_height") @db.VarChar(120)
  propertyClass             String?              @map("property_class") @db.VarChar(120)
  floorRange                String?              @map("floor_range") @db.VarChar(120)
  apartmentsCountText       String?              @map("apartments_count_text") @db.VarChar(120)
  priceFrom                 Decimal?             @map("price_from") @db.Decimal(14, 2)
  pricePerMeterFrom         Decimal?             @map("price_per_meter_from") @db.Decimal(14, 2)
  feedPriceFrom             Decimal?             @map("feed_price_from") @db.Decimal(14, 2)
  feedPricePerMeterFrom     Decimal?             @map("feed_price_per_meter_from") @db.Decimal(14, 2)
  feedAreaRange             String?              @map("feed_area_range") @db.VarChar(120)
  feedFloorRange            String?              @map("feed_floor_range") @db.VarChar(120)
  feedUnitsCount            Int?                 @map("feed_units_count")
  feedUnitsCountText        String?              @map("feed_units_count_text") @db.VarChar(120)
  feedCompletionYear        Int?                 @map("feed_completion_year")
  feedCompletionQuarter     Int?                 @map("feed_completion_quarter")
  feedUpdatedAt             DateTime?            @map("feed_updated_at")
  completionYear            Int?                 @map("completion_year")
  completionQuarter         Int?                 @map("completion_quarter")
  address                   String?
  latitude                  Decimal?             @db.Decimal(9, 6)
  longitude                 Decimal?             @db.Decimal(9, 6)
  featuresJson              Json                 @default("{}") @map("features_json")
  developerId               String?              @map("developer_id") @db.Uuid
  primaryLocationId         String?              @map("primary_location_id") @db.Uuid
  publishedAt               DateTime?            @map("published_at")
  archivedAt                DateTime?            @map("archived_at")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  deletedAt                 DateTime?            @map("deleted_at")

  developer                        Developer?                          @relation(fields: [developerId], references: [id], onDelete: SetNull)
  primaryLocation                  Location?                           @relation("PrimaryObjectLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  locations                        ObjectLocation[]
  metroStations                    ObjectMetroStation[]
  images                           ObjectImage[]
  files                            ObjectFile[]
  auditLogs                        AuditLog[]                          @relation("ObjectAuditLogs")
  catalogQuickLinks                CatalogQuickLink[]
  feedSources                      FeedSource[]
  feedSourceMappings               FeedSourceMapping[]
  feedUnits                        FeedUnit[]
  projectPresentationDraftItems    ProjectPresentationDraftObject[]
  projectPresentationDocumentItems ProjectPresentationDocumentObject[]
  trainingProjects                 TrainingProject[]

  @@index([status])
  @@index([type])
  @@index([developerId])
  @@index([primaryLocationId])
  @@index([priceFrom])
  @@index([feedPriceFrom])
  @@index([feedPricePerMeterFrom])
  @@index([feedUpdatedAt])
  @@index([completionYear])
  @@index([latitude, longitude])
  @@map("real_estate_objects")
}

model ObjectLocation {
  objectId   String   @map("object_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  object   RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([objectId, locationId])
  @@index([locationId])
  @@map("object_locations")
}

model ObjectMetroStation {
  objectId       String   @map("object_id") @db.Uuid
  metroStationId String   @map("metro_station_id") @db.Uuid
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  object       RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  metroStation MetroStation     @relation(fields: [metroStationId], references: [id], onDelete: Restrict)

  @@id([objectId, metroStationId])
  @@index([metroStationId])
  @@map("object_metro_stations")
}

model CatalogQuickLink {
  id          String               @id @default(uuid()) @db.Uuid
  type        CatalogQuickLinkType
  label       String               @db.VarChar(160)
  sortOrder   Int                  @default(0) @map("sort_order")
  isEnabled   Boolean              @default(true) @map("is_enabled")
  developerId String?              @map("developer_id") @db.Uuid
  objectId    String?              @map("object_id") @db.Uuid
  krtName     String?              @map("krt_name") @db.VarChar(240)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  developer Developer?        @relation(fields: [developerId], references: [id], onDelete: SetNull)
  object    RealEstateObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)

  @@index([type, sortOrder])
  @@index([developerId])
  @@index([objectId])
  @@map("catalog_quick_links")
}

model FeedSource {
  id            String         @id @default(uuid()) @db.Uuid
  sourceKind    FeedSourceKind @default(URL) @map("source_kind")
  url           String?        @db.VarChar(2048)
  xmlFileId     String?        @map("xml_file_id") @db.Uuid
  format        FeedFormat
  filterJson    Json?          @map("filter_json")
  developerId   String         @map("developer_id") @db.Uuid
  objectId      String?        @map("object_id") @db.Uuid
  isActive      Boolean        @default(true) @map("is_active")
  deletedAt     DateTime?      @map("deleted_at")
  lastPreviewAt DateTime?      @map("last_preview_at")
  lastRunAt     DateTime?      @map("last_run_at")
  lastSuccessAt DateTime?      @map("last_success_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  developer Developer           @relation(fields: [developerId], references: [id], onDelete: Restrict)
  object    RealEstateObject?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  xmlFile   File?               @relation("FeedXmlFile", fields: [xmlFileId], references: [id], onDelete: Restrict)
  mappings  FeedSourceMapping[]
  runs      FeedImportRun[]
  units     FeedUnit[]

  @@index([sourceKind])
  @@index([xmlFileId])
  @@index([developerId])
  @@index([objectId, isActive])
  @@index([deletedAt])
  @@index([format])
  @@map("feed_sources")
}

model FeedSourceMapping {
  id          String   @id @default(uuid()) @db.Uuid
  sourceId    String   @map("source_id") @db.Uuid
  objectId    String   @map("object_id") @db.Uuid
  sourceKey   String   @map("source_key") @db.VarChar(255)
  sourceTitle String   @map("source_title") @db.VarChar(300)
  filterJson  Json     @map("filter_json")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  source FeedSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  object RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceKey])
  @@index([sourceId, isActive])
  @@index([objectId])
  @@map("feed_source_mappings")
}

model FeedImportRun {
  id           String       @id @default(uuid()) @db.Uuid
  sourceId     String       @map("source_id") @db.Uuid
  mode         ImportMode
  status       ImportStatus @default(PENDING)
  startedAt    DateTime     @default(now()) @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  summaryJson  Json?        @map("summary_json")
  warningsJson Json?        @map("warnings_json")
  errorsJson   Json?        @map("errors_json")
  createdAt    DateTime     @default(now()) @map("created_at")

  source FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([mode, status])
  @@index([createdAt])
  @@map("feed_import_runs")
}

model FeedUnit {
  id                     String         @id @default(uuid()) @db.Uuid
  sourceId               String         @map("source_id") @db.Uuid
  objectId               String         @map("object_id") @db.Uuid
  externalId             String         @map("external_id") @db.VarChar(255)
  type                   FeedUnitType
  status                 FeedUnitStatus @default(UNKNOWN)
  title                  String?        @db.VarChar(300)
  address                String?        @db.VarChar(512)
  building               String?        @db.VarChar(120)
  section                String?        @db.VarChar(120)
  floor                  Int?
  rooms                  Int?
  price                  Decimal?       @db.Decimal(14, 2)
  discountPrice          Decimal?       @map("discount_price") @db.Decimal(14, 2)
  effectivePrice         Decimal?       @map("effective_price") @db.Decimal(14, 2)
  currency               String?        @db.VarChar(12)
  area                   Decimal?       @db.Decimal(10, 2)
  pricePerMeter          Decimal?       @map("price_per_meter") @db.Decimal(14, 2)
  discountPricePerMeter  Decimal?       @map("discount_price_per_meter") @db.Decimal(14, 2)
  effectivePricePerMeter Decimal?       @map("effective_price_per_meter") @db.Decimal(14, 2)
  completionYear         Int?           @map("completion_year")
  completionQuarter      Int?           @map("completion_quarter")
  rawPayload             Json?          @map("raw_payload")
  archivedAt             DateTime?      @map("archived_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  source                        FeedSource                      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  object                        RealEstateObject                @relation(fields: [objectId], references: [id], onDelete: Cascade)
  residentialDetails            FeedResidentialUnitDetails?
  commercialDetails             FeedCommercialUnitDetails?
  media                         FeedUnitMedia[]
  lotPresentationItems          LotPresentationCollectionItem[]
  lotPresentationWorkspaceItems LotPresentationWorkspaceItem[]
  lotPresentationDocumentItems  LotPresentationDocumentItem[]

  @@unique([sourceId, externalId])
  @@index([objectId, status])
  @@index([sourceId, status])
  @@index([type])
  @@index([status])
  @@index([price])
  @@index([pricePerMeter])
  @@index([discountPrice])
  @@index([effectivePrice])
  @@index([discountPricePerMeter])
  @@index([effectivePricePerMeter])
  @@index([area])
  @@map("feed_units")
}

model FeedResidentialUnitDetails {
  unitId          String   @id @map("unit_id") @db.Uuid
  apartmentNumber String?  @map("apartment_number") @db.VarChar(120)
  layoutType      String?  @map("layout_type") @db.VarChar(120)
