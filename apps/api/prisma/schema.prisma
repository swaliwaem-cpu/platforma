  @@index([projectId, startedAt])
  @@index([reviewedById])
  @@map("training_attempts")
}

model TrainingAttemptQuestion {
  id                   String                        @id @default(uuid()) @db.Uuid
  attemptId            String                        @map("attempt_id") @db.Uuid
  sourceQuestionId     String?                       @map("source_question_id") @db.Uuid
  sequence             Int
  type                 TrainingQuestionType
  questionTextSnapshot String                        @map("question_text_snapshot")
  maxScore             Int                           @map("max_score")
  status               TrainingAttemptQuestionStatus @default(PRESENTED)
  presentedAt          DateTime                      @default(now()) @map("presented_at")
  answeredAt           DateTime?                     @map("answered_at")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  attempt        TrainingAttempt   @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  sourceQuestion TrainingQuestion? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  answer         TrainingAnswer?

  @@unique([attemptId, sequence])
  @@unique([attemptId, sourceQuestionId])
  @@index([sourceQuestionId])
  @@map("training_attempt_questions")
}

model TrainingAnswer {
  id                  String                         @id @default(uuid()) @db.Uuid
  attemptQuestionId   String                         @unique @map("attempt_question_id") @db.Uuid
  source              TrainingAnswerSource           @default(TEXT)
  processingStatus    TrainingAnswerProcessingStatus @default(COMPLETED) @map("processing_status")
  text                String?
  score               Int?
  fakeOutcome         TrainingFakeOutcome?           @map("fake_outcome")
  safeBreakdownJson   Json?                          @map("safe_breakdown_json")
  mergedAudioFileId   String?                        @unique @map("merged_audio_file_id") @db.Uuid
  processingAttempts  Int                            @default(0) @map("processing_attempts")
  processingLockedAt  DateTime?                      @map("processing_locked_at")
  processingLockedBy  String?                        @map("processing_locked_by") @db.VarChar(128)
  processingErrorCode String?                        @map("processing_error_code") @db.VarChar(64)
  transcriptionStatus TrainingAiStepStatus           @default(PENDING) @map("transcription_status")
  evaluationStatus    TrainingAiStepStatus           @default(PENDING) @map("evaluation_status")
  transcriptionAttempts Int                          @default(0) @map("transcription_attempts")
  evaluationAttempts  Int                            @default(0) @map("evaluation_attempts")
  transcriptionModel  String?                        @map("transcription_model") @db.VarChar(120)
  evaluationModel     String?                        @map("evaluation_model") @db.VarChar(120)
  transcriptionRequestId String?                     @map("transcription_request_id") @db.VarChar(160)
  evaluationRequestId String?                        @map("evaluation_request_id") @db.VarChar(160)
  transcriptionLatencyMs Int?                        @map("transcription_latency_ms")
  evaluationLatencyMs Int?                           @map("evaluation_latency_ms")
  evaluationSchemaVersion String?                    @map("evaluation_schema_version") @db.VarChar(64)
  evaluationJson      Json?                          @map("evaluation_json")
  objectiveMetricsJson Json?                         @map("objective_metrics_json")
  submittedAt         DateTime?                      @map("submitted_at")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  attemptQuestion TrainingAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Restrict)
  mergedAudioFile File?                   @relation("TrainingAnswerMergedAudio", fields: [mergedAudioFileId], references: [id], onDelete: Restrict)
  segments        TrainingAnswerSegment[]

  @@index([processingStatus, processingLockedAt, createdAt])
  @@map("training_answers")
}

model TrainingTelegramAccount {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  telegramUserId BigInt    @map("telegram_user_id") @db.BigInt
  chatId         BigInt    @map("chat_id") @db.BigInt
  username       String?   @db.VarChar(64)
  linkedAt       DateTime  @default(now()) @map("linked_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([telegramUserId])
  @@index([chatId])
  @@map("training_telegram_accounts")
}

model TrainingTelegramLinkToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  project TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
  @@index([projectId])
  @@index([expiresAt])
  @@map("training_telegram_link_tokens")
}

model TrainingAnswerSegment {
  id                   String   @id @default(uuid()) @db.Uuid
  answerId             String   @map("answer_id") @db.Uuid
  position             Int
  telegramMessageId    BigInt   @map("telegram_message_id") @db.BigInt
  telegramFileId       String   @map("telegram_file_id") @db.VarChar(512)
  telegramFileUniqueId String   @map("telegram_file_unique_id") @db.VarChar(512)
  durationSeconds      Int      @map("duration_seconds")
  sizeBytes            BigInt?  @map("size_bytes") @db.BigInt
  storedFileId         String?  @map("stored_file_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  answer     TrainingAnswer @relation(fields: [answerId], references: [id], onDelete: Restrict)
  storedFile File?          @relation("TrainingAnswerSegmentStoredFile", fields: [storedFileId], references: [id], onDelete: Restrict)

  @@unique([answerId, position])
  @@unique([answerId, telegramMessageId])
  @@unique([answerId, telegramFileUniqueId])
  @@index([storedFileId])
  @@map("training_answer_segments")
}
