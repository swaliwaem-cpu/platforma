generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE      @map("active")
  BLOCKED     @map("blocked")
  INVITED     @map("invited")
  DEACTIVATED @map("deactivated")

  @@map("user_status")
}

enum ObjectStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("object_status")
}

enum LocationType {
  AREA     @map("area")
  DISTRICT @map("district")
  CUSTOM   @map("custom")

  @@map("location_type")
}

enum FileStorage {
  LOCAL @map("local")
  MINIO @map("minio")

  @@map("file_storage")
}

enum FileVariantKind {
  THUMBNAIL @map("thumbnail")
  CARD      @map("card")
  DETAIL    @map("detail")

  @@map("file_variant_kind")
}

enum ObjectFileType {
  PRESENTATION @map("presentation")
  FLOOR_PLAN   @map("floor_plan")
  DOCUMENT     @map("document")
  OTHER        @map("other")

  @@map("object_file_type")
}

enum ObjectImageSection {
  ARCHITECTURE @map("architecture")
  INTERIORS    @map("interiors")
  FILLING      @map("filling")

  @@map("object_image_section")
}

enum ImportMode {
  PREVIEW @map("preview")
  RUN     @map("run")

  @@map("import_mode")
}

enum ImportStatus {
  PENDING @map("pending")
  SUCCESS @map("success")
  PARTIAL @map("partial")
  FAILED  @map("failed")

  @@map("import_status")
}

enum CatalogQuickLinkType {
  DEVELOPER   @map("developer")
  KRT         @map("krt")
  SALES_START @map("sales_start")

  @@map("catalog_quick_link_type")
}

enum FeedFormat {
  YANDEX_REALTY @map("yandex_realty")
  CIAN_XML      @map("cian_xml")

  @@map("feed_format")
}

enum FeedSourceKind {
  URL  @map("url")
  FILE @map("file")

  @@map("feed_source_kind")
}

enum FeedUnitType {
  RESIDENTIAL @map("residential")
  COMMERCIAL  @map("commercial")

  @@map("feed_unit_type")
}

enum FeedUnitStatus {
  AVAILABLE @map("available")
  BOOKED    @map("booked")
  RESERVED  @map("reserved")
  SOLD      @map("sold")
  ARCHIVED  @map("archived")
  UNKNOWN   @map("unknown")

  @@map("feed_unit_status")
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  email                 String     @unique @db.VarChar(320)
  passwordHash          String     @map("password_hash")
  refreshTokenHash      String?    @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime?  @map("refresh_token_expires_at")
  name                  String?
  profilePhotoFileId    String?    @map("profile_photo_file_id") @db.Uuid
  status                UserStatus @default(INVITED)
  roleId                String     @map("role_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  role             Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  profilePhotoFile File?          @relation("UserProfilePhoto", fields: [profilePhotoFileId], references: [id], onDelete: SetNull)
  auditLogs        AuditLog[]     @relation("AuditActor")
  emailAuthChallenges EmailAuthChallenge[]
  importReports    ImportReport[] @relation("ImportReportCreator")
  uploadedFiles    File[]         @relation("FileUploader")

  @@index([roleId])
  @@index([profilePhotoFileId])
  @@index([status])
  @@map("users")
}

model EmailAuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.VarChar(320)
  tokenHash  String    @unique @map("token_hash")
  codeHash   String    @map("code_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, codeHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("email_auth_challenges")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Developer {
  id             String   @id @default(uuid()) @db.Uuid
  wpTermId       Int?     @unique @map("wp_term_id")
  name           String   @unique
  normalizedName String?  @unique @map("normalized_name")
  slug           String?  @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  objects           RealEstateObject[]
  catalogQuickLinks CatalogQuickLink[]
  feedSources       FeedSource[]

  @@map("developers")
}

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  wpTermId  Int?         @unique @map("wp_term_id")
  name      String
  slug      String
  type      LocationType @default(CUSTOM)
  parentId  String?      @map("parent_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  parent         Location?          @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Location[]         @relation("LocationTree")
  primaryObjects RealEstateObject[] @relation("PrimaryObjectLocation")
  objectLinks    ObjectLocation[]

  @@unique([type, slug])
  @@index([parentId])
  @@map("locations")
}

model MetroStation {
  id        String   @id @default(uuid()) @db.Uuid
  wpTermId  Int?     @unique @map("wp_term_id")
  name      String
  slug      String
  lineName  String?  @map("line_name")
  lineColor String?  @map("line_color") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  objectLinks ObjectMetroStation[]

  @@unique([lineName, slug])
  @@index([lineName])
  @@map("metro_stations")
}

model RealEstateObject {
  id                String       @id @default(uuid()) @db.Uuid
  wpPostId          Int?         @unique @map("wp_post_id")
  title             String
  slug              String       @unique
  status            ObjectStatus @default(DRAFT)
  description       String?
  architectureDescription String? @map("architecture_description")
  infrastructureDescription String? @map("infrastructure_description")
  fillingDescription String? @map("filling_description")
  shortDescription  String?      @map("short_description")
  layoutsUrl        String?      @map("layouts_url") @db.VarChar(2048)
  krtName           String?      @map("krt_name") @db.VarChar(240)
  apartmentAreaRange String?     @map("apartment_area_range") @db.VarChar(120)
  ceilingHeight     String?      @map("ceiling_height") @db.VarChar(120)
  propertyClass     String?      @map("property_class") @db.VarChar(120)
  floorRange        String?      @map("floor_range") @db.VarChar(120)
  apartmentsCountText String?    @map("apartments_count_text") @db.VarChar(120)
  priceFrom         Decimal?     @map("price_from") @db.Decimal(14, 2)
  pricePerMeterFrom Decimal?     @map("price_per_meter_from") @db.Decimal(14, 2)
  feedPriceFrom     Decimal?     @map("feed_price_from") @db.Decimal(14, 2)
  feedPricePerMeterFrom Decimal? @map("feed_price_per_meter_from") @db.Decimal(14, 2)
  feedAreaRange     String?      @map("feed_area_range") @db.VarChar(120)
  feedFloorRange    String?      @map("feed_floor_range") @db.VarChar(120)
  feedUnitsCount    Int?         @map("feed_units_count")
  feedUnitsCountText String?     @map("feed_units_count_text") @db.VarChar(120)
  feedCompletionYear Int?        @map("feed_completion_year")
  feedCompletionQuarter Int?     @map("feed_completion_quarter")
  feedUpdatedAt     DateTime?    @map("feed_updated_at")
  completionYear    Int?         @map("completion_year")
  completionQuarter Int?         @map("completion_quarter")
  address           String?
  latitude          Decimal?     @db.Decimal(9, 6)
  longitude         Decimal?     @db.Decimal(9, 6)
  featuresJson      Json         @default("{}") @map("features_json")
  developerId       String?      @map("developer_id") @db.Uuid
  primaryLocationId String?      @map("primary_location_id") @db.Uuid
  publishedAt       DateTime?    @map("published_at")
  archivedAt        DateTime?    @map("archived_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  developer       Developer?           @relation(fields: [developerId], references: [id], onDelete: SetNull)
  primaryLocation Location?            @relation("PrimaryObjectLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)
  locations       ObjectLocation[]
  metroStations   ObjectMetroStation[]
  images          ObjectImage[]
  files           ObjectFile[]
  auditLogs       AuditLog[]           @relation("ObjectAuditLogs")
  catalogQuickLinks CatalogQuickLink[]
  feedSources     FeedSource[]
  feedUnits       FeedUnit[]

  @@index([status])
  @@index([developerId])
  @@index([primaryLocationId])
  @@index([priceFrom])
  @@index([feedPriceFrom])
  @@index([feedPricePerMeterFrom])
  @@index([feedUpdatedAt])
  @@index([completionYear])
  @@index([latitude, longitude])
  @@map("real_estate_objects")
}

model ObjectLocation {
  objectId   String   @map("object_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  object   RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  location Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([objectId, locationId])
  @@index([locationId])
  @@map("object_locations")
}

model ObjectMetroStation {
  objectId       String   @map("object_id") @db.Uuid
  metroStationId String   @map("metro_station_id") @db.Uuid
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  object       RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  metroStation MetroStation     @relation(fields: [metroStationId], references: [id], onDelete: Restrict)

  @@id([objectId, metroStationId])
  @@index([metroStationId])
  @@map("object_metro_stations")
}

model CatalogQuickLink {
  id          String               @id @default(uuid()) @db.Uuid
  type        CatalogQuickLinkType
  label       String               @db.VarChar(160)
  sortOrder   Int                  @default(0) @map("sort_order")
  isEnabled   Boolean              @default(true) @map("is_enabled")
  developerId String?              @map("developer_id") @db.Uuid
  objectId    String?              @map("object_id") @db.Uuid
  krtName     String?              @map("krt_name") @db.VarChar(240)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  developer Developer?        @relation(fields: [developerId], references: [id], onDelete: SetNull)
  object    RealEstateObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)

  @@index([type, sortOrder])
  @@index([developerId])
  @@index([objectId])
  @@map("catalog_quick_links")
}

model FeedSource {
  id            String    @id @default(uuid()) @db.Uuid
  sourceKind    FeedSourceKind @default(URL) @map("source_kind")
  url           String?   @db.VarChar(2048)
  xmlFileId     String?   @map("xml_file_id") @db.Uuid
  format        FeedFormat
  developerId   String    @map("developer_id") @db.Uuid
  objectId      String    @map("object_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  lastPreviewAt DateTime? @map("last_preview_at")
  lastRunAt     DateTime? @map("last_run_at")
  lastSuccessAt DateTime? @map("last_success_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  developer Developer        @relation(fields: [developerId], references: [id], onDelete: Restrict)
  object    RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  xmlFile   File?            @relation("FeedXmlFile", fields: [xmlFileId], references: [id], onDelete: Restrict)
  runs      FeedImportRun[]
  units     FeedUnit[]

  @@index([sourceKind])
  @@index([xmlFileId])
  @@index([developerId])
  @@index([objectId, isActive])
  @@index([format])
  @@map("feed_sources")
}

model FeedImportRun {
  id           String       @id @default(uuid()) @db.Uuid
  sourceId     String       @map("source_id") @db.Uuid
  mode         ImportMode
  status       ImportStatus @default(PENDING)
  startedAt    DateTime     @default(now()) @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  summaryJson  Json?        @map("summary_json")
  warningsJson Json?        @map("warnings_json")
  errorsJson   Json?        @map("errors_json")
  createdAt    DateTime     @default(now()) @map("created_at")

  source FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([mode, status])
  @@index([createdAt])
  @@map("feed_import_runs")
}

model FeedUnit {
  id                String         @id @default(uuid()) @db.Uuid
  sourceId          String         @map("source_id") @db.Uuid
  objectId          String         @map("object_id") @db.Uuid
  externalId        String         @map("external_id") @db.VarChar(255)
  type              FeedUnitType
  status            FeedUnitStatus @default(UNKNOWN)
  title             String?        @db.VarChar(300)
  address           String?        @db.VarChar(512)
  building          String?        @db.VarChar(120)
  section           String?        @db.VarChar(120)
  floor             Int?
  rooms             Int?
  price             Decimal?       @db.Decimal(14, 2)
  currency          String?        @db.VarChar(12)
  area              Decimal?       @db.Decimal(10, 2)
  pricePerMeter     Decimal?       @map("price_per_meter") @db.Decimal(14, 2)
  completionYear    Int?           @map("completion_year")
  completionQuarter Int?           @map("completion_quarter")
  rawPayload        Json?          @map("raw_payload")
  archivedAt        DateTime?      @map("archived_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  source            FeedSource                 @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  object            RealEstateObject           @relation(fields: [objectId], references: [id], onDelete: Cascade)
  residentialDetails FeedResidentialUnitDetails?
  commercialDetails  FeedCommercialUnitDetails?
  media             FeedUnitMedia[]

  @@unique([sourceId, externalId])
  @@index([objectId, status])
  @@index([sourceId, status])
  @@index([type])
  @@index([status])
  @@index([price])
  @@index([pricePerMeter])
  @@index([area])
  @@map("feed_units")
}

model FeedResidentialUnitDetails {
  unitId          String   @id @map("unit_id") @db.Uuid
  apartmentNumber String?  @map("apartment_number") @db.VarChar(120)
  layoutType      String?  @map("layout_type") @db.VarChar(120)
  livingArea      Decimal? @map("living_area") @db.Decimal(10, 2)
  kitchenArea     Decimal? @map("kitchen_area") @db.Decimal(10, 2)
  balconyCount    Int?     @map("balcony_count")
  detailsJson     Json     @default("{}") @map("details_json")

  unit FeedUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("feed_residential_unit_details")
}

model FeedCommercialUnitDetails {
  unitId           String   @id @map("unit_id") @db.Uuid
  commercialType   String?  @map("commercial_type") @db.VarChar(120)
  entrance         String?  @db.VarChar(120)
  ceilingHeight    Decimal? @map("ceiling_height") @db.Decimal(5, 2)
  powerKw          Decimal? @map("power_kw") @db.Decimal(8, 2)
  separateEntrance Boolean? @map("separate_entrance")
  detailsJson      Json     @default("{}") @map("details_json")

  unit FeedUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("feed_commercial_unit_details")
}

model FeedMediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  sourceUrl   String   @unique @map("source_url") @db.VarChar(2048)
  fileId      String?  @map("file_id") @db.Uuid
  contentType String?  @map("content_type") @db.VarChar(120)
  checksum    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  file      File?           @relation("FeedMediaFile", fields: [fileId], references: [id], onDelete: SetNull)
  unitLinks FeedUnitMedia[]

  @@index([fileId])
  @@map("feed_media_assets")
}

model FeedUnitMedia {
  unitId       String   @map("unit_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  label        String?  @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at")

  unit       FeedUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  mediaAsset FeedMediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([unitId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([unitId, sortOrder])
  @@map("feed_unit_media")
}

model File {
  id             String      @id @default(uuid()) @db.Uuid
  wpAttachmentId Int?        @unique @map("wp_attachment_id")
  storage        FileStorage @default(MINIO)
  bucket         String?
  key            String
  url            String?
  originalName   String?     @map("original_name")
  mimeType       String?     @map("mime_type")
  sizeBytes      BigInt?     @map("size_bytes")
  checksum       String?
  uploadedById   String?     @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  uploadedBy         User?         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  profilePhotoUsers  User[]        @relation("UserProfilePhoto")
  objectImages       ObjectImage[]
  objectFiles        ObjectFile[]
  variants           FileVariant[]
  feedXmlSources     FeedSource[] @relation("FeedXmlFile")
  feedMediaAssets    FeedMediaAsset[] @relation("FeedMediaFile")

  @@unique([storage, bucket, key])
  @@index([uploadedById])
  @@map("files")
}

model FileVariant {
  fileId    String          @map("file_id") @db.Uuid
  variant   FileVariantKind
  storage   FileStorage     @default(MINIO)
  bucket    String?
  key       String
  url       String?
  mimeType  String          @map("mime_type")
  width     Int
  height    Int
  sizeBytes BigInt          @map("size_bytes")
  checksum  String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, variant])
  @@unique([storage, bucket, key])
  @@map("file_variants")
}

model ObjectImage {
  id            String   @id @default(uuid()) @db.Uuid
  objectId      String   @map("object_id") @db.Uuid
  fileId        String   @map("file_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  isCover       Boolean  @default(false) @map("is_cover")
  section       ObjectImageSection? @map("section")
  alt           String?
  title         String?
  sourceMetaKey String?  @map("source_meta_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  object RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  file   File             @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([objectId, fileId])
  @@index([fileId])
  @@index([objectId, isCover])
  @@index([objectId, section])
  @@map("object_images")
}

model ObjectFile {
  id            String         @id @default(uuid()) @db.Uuid
  objectId      String         @map("object_id") @db.Uuid
  fileId        String         @map("file_id") @db.Uuid
  type          ObjectFileType @default(OTHER)
  title         String?
  sortOrder     Int            @default(0) @map("sort_order")
  sourceMetaKey String?        @map("source_meta_key")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  object RealEstateObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  file   File             @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([objectId, fileId, type])
  @@index([fileId])
  @@index([objectId, type])
  @@map("object_files")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(120)
  entityId    String?  @map("entity_id") @db.VarChar(120)
  objectId    String?  @map("object_id") @db.Uuid
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor  User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  object RealEstateObject? @relation("ObjectAuditLogs", fields: [objectId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([objectId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ImportReport {
  id           String       @id @default(uuid()) @db.Uuid
  mode         ImportMode
  status       ImportStatus @default(PENDING)
  source       String       @default("wordpress") @db.VarChar(120)
  startedAt    DateTime     @default(now()) @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  summaryJson  Json?        @map("summary_json")
  warningsJson Json?        @map("warnings_json")
  errorsJson   Json?        @map("errors_json")
  createdById  String?      @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  createdBy User? @relation("ImportReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([mode, status])
  @@index([createdById])
  @@index([createdAt])
  @@map("import_reports")
}
